{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hajat Manager",
  "version": "1.1.4",
  "identifier": "com.hajatmanager.app",
  "build": {
    "devUrl": "http://localhost:3000",
    "frontendDist": "../../../out"
  },
  "app": {
    "windows": [
      {
        "title": "Hajat Manager",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "category": "Productivity",
    "shortDescription": "Hajat Manager offline-first",
    "longDescription": "Hajat Manager — Windows native via Tauri, offline SQLite + 30m background sync + PIN 6 digit, sideload EXE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": []
    },
    "store": {}
  }
}
