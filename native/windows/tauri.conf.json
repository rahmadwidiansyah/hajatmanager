{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hajat Manager",
  "version": "1.0.3",
  "identifier": "com.hajatmanager.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 3000",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "bash ../../scripts/build-native.sh",
    "frontendDist": "../../out"
  },
  "app": {
    "windows": [
      {
        "title": "Hajat Manager",
        "width": 1200,
        "height": 800,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Hajat Manager offline-first",
    "longDescription": "Hajat Manager — Windows native via Tauri, offline SQLite + 30m background sync + PIN 6 digit, sideload EXE",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      },
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      }
    },
    "icon": [
      "src-tauri/icons/32x32.png",
      "src-tauri/icons/128x128.png",
      "src-tauri/icons/icon.ico"
    ]
  },
  "plugins": {
    "sql": {
      "preload": []
    },
    "store": {}
  }
}
