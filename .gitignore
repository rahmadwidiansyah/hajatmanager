# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# serwist — Service Worker hasil build (dibangun ulang tiap `next build`)
public/sw.js
public/sw.js.map
public/sw-*.js
public/swe-worker-*.js

# production
/build

# release artifacts — dibangun ulang di CI (release-assets.yml), jangan commit
/release/
*.exe
*.apk
*.aab
**/build/
test-results/
playwright-report/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android signing - jangan commit credential
*.jks
*.keystore
key.properties
**/keystore.properties
**/release.keystore
app/release.keystore
