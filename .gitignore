# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# serwist — Service Worker hasil build (dibangun ulang tiap `next build`)
public/sw.js
public/sw.js.map
public/sw-*.js
public/swe-worker-*.js

# production
/build

# release artifacts — dibangun ulang di CI (release-assets.yml), jangan commit
/release/
*.exe
*.apk
*.aab
**/build/
test-results/
playwright-report/

# AI assistant files - repo dibuat sesimpel mungkin, tanpa file AI
.agents/
.claude/
.cursor/
.devin/
.codex/
AGENTS.md
CLAUDE.md
GEMINI.md
CODEX.md
skills-lock.json

# misc
.DS_Store
Thumbs.db
*.pem
*.swp

# IDE
.vscode/
.idea/
*.iml

# build caches & logs
.turbo/
dist/
*.log

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# android signing - jangan commit credential
*.jks
*.keystore
key.properties
**/keystore.properties
**/release.keystore
app/release.keystore

# runtime uploads - data user di VPS, jangan commit (kecuali penanda folder)
public/uploads/*
!public/uploads/.gitkeep
