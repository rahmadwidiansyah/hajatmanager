{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    ["@semantic-release/exec", { "prepareCmd": "node scripts/sync-versions.js ${nextRelease.version}" }],
    ["@semantic-release/git", { "assets": ["package.json", "package-lock.json", "native/windows/tauri.conf.json", "native/windows/src-tauri/Cargo.toml", "native/windows/package.json", "mobile/pubspec.yaml", "CHANGELOG.md"], "message": "chore(release): ${nextRelease.version}" }],
    "@semantic-release/github"
  ]
}
