{
  "branches": ["main"],
  "plugins": [
    "@semantic-release/commit-analyzer",
    "@semantic-release/release-notes-generator",
    ["@semantic-release/changelog", { "changelogFile": "CHANGELOG.md" }],
    ["@semantic-release/npm", { "npmPublish": false }],
    ["@semantic-release/exec", { "prepareCmd": "node scripts/sync-versions.js ${nextRelease.version}" }],
    ["@semantic-release/git", { "assets": ["package.json", "package-lock.json", "mobile/pubspec.yaml", "CHANGELOG.md", "packages/shared-core/package.json", "windows/src/HajatManager/HajatManager.csproj", "windows/installer/hajat-manager.iss", "packaging/linux/PKGBUILD"], "message": "chore(release): ${nextRelease.version}" }],
    "@semantic-release/github"
  ]
}
