<Application x:Class="HajatManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="Views/LoginWindow.xaml">
  <Application.Resources>
    <!-- Token M3 cermin app/globals.css (light) -->
    <Color x:Key="Primary">#059669</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="Surface">#F8FAFC</Color>
    <Color x:Key="SurfaceLowest">#FFFFFF</Color>
    <Color x:Key="SurfaceContainer">#E8EDF4</Color>
    <Color x:Key="OnSurface">#0F172A</Color>
    <Color x:Key="OnSurfaceVariant">#475569</Color>
    <Color x:Key="OutlineVariant">#CBD5E1</Color>
    <Color x:Key="Error">#DC2626</Color>
    <Color x:Key="ErrorContainer">#FEE2E2</Color>
    <SolidColorBrush x:Key="PrimaryBrush" Color="{StaticResource Primary}"/>
    <SolidColorBrush x:Key="OnPrimaryBrush" Color="{StaticResource OnPrimary}"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource Surface}"/>
    <SolidColorBrush x:Key="CardBrush" Color="{StaticResource SurfaceLowest}"/>
    <SolidColorBrush x:Key="OnSurfaceBrush" Color="{StaticResource OnSurface}"/>
    <SolidColorBrush x:Key="OnVariantBrush" Color="{StaticResource OnSurfaceVariant}"/>
    <SolidColorBrush x:Key="OutlineBrush" Color="{StaticResource OutlineVariant}"/>
    <SolidColorBrush x:Key="ErrorBrush" Color="{StaticResource Error}"/>

    <Style TargetType="Button" x:Key="PrimaryButton">
      <Setter Property="Background" Value="{StaticResource PrimaryBrush}"/>
      <Setter Property="Foreground" Value="{StaticResource OnPrimaryBrush}"/>
      <Setter Property="Padding" Value="16,10"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border Background="{TemplateBinding Background}" CornerRadius="12"
                    Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="IsEnabled" Value="False">
          <Setter Property="Opacity" Value="0.5"/>
        </Trigger>
      </Style.Triggers>
    </Style>

    <Style TargetType="TextBox">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    </Style>

    <Style TargetType="PasswordBox">
      <Setter Property="Padding" Value="12,10"/>
      <Setter Property="BorderBrush" Value="{StaticResource OutlineBrush}"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="Background" Value="{StaticResource CardBrush}"/>
    </Style>
  </Application.Resources>
</Application>
