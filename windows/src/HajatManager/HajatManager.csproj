<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\Assets\app.ico</ApplicationIcon>
    <AssemblyName>HajatManager</AssemblyName>
    <RootNamespace>HajatManager</RootNamespace>
    <Version>1.5.0</Version>
    <Company>Rahmad Widiansyah</Company>
    <Product>Hajat Manager</Product>
    <Description>Hajat Manager — buku tamu &amp; catat pemberian hajatan (Windows)</Description>
    <!-- Single-file agar distribusi ZIP semudah Flutter -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>false</SelfContained>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Assets\app.ico" />
  </ItemGroup>

</Project>
