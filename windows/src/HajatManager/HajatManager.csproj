<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\..\Assets\app.ico</ApplicationIcon>
    <AssemblyName>HajatManager</AssemblyName>
    <RootNamespace>HajatManager</RootNamespace>
    <Version>1.18.2</Version>
    <Company>Rahmad Widiansyah</Company>
    <Product>Hajat Manager</Product>
    <Description>Hajat Manager — buku tamu &amp; catat pemberian hajatan (Windows)</Description>
    <!-- Self-contained penuh: Setup.exe mandiri tanpa install .NET.
         ZIP portable framework-dependent dihapus total. -->
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <PublishTrimmed>false</PublishTrimmed>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.0" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="9.0.0" />
    <PackageReference Include="QuestPDF" Version="2024.12.0" />
    <PackageReference Include="ClosedXML" Version="0.104.2" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="..\..\Assets\app.ico" />
    <!-- Font M3 dibundle agar WPF konsisten dengan web/mobile (Plus Jakarta + Geist Mono tabular).
         Fallback Segoe UI bila resource gagal load (lihat Themes/M3Styles.xaml AppFont/NumericFont). -->
    <Resource Include="..\..\Assets\Fonts\PlusJakartaSans-Variable.ttf" />
    <Resource Include="..\..\Assets\Fonts\GeistMono-Variable.ttf" />
  </ItemGroup>

</Project>
