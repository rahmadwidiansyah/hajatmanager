<Window x:Class="HajatManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hajat Manager" Height="760" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">
  <DockPanel>
    <Menu DockPanel.Dock="Top">
      <MenuItem x:Name="AcaraMenu" Header="Acara" Click="GoEvents"/>
      <MenuItem x:Name="AkunMenu" Header="Akun" Click="GoAccount"/>
      <MenuItem Header="Sync Semua" Click="OnSyncAll"/>
      <MenuItem Header="Keluar" Click="OnLogout"/>
    </Menu>
    <StatusBar DockPanel.Dock="Bottom">
      <StatusBarItem>
        <TextBlock x:Name="StatusText" Text="Siap"/>
      </StatusBarItem>
    </StatusBar>
    <!-- page-shell cermin web (max 1120px, auto-center) -->
    <ContentControl x:Name="Host" Margin="16" MaxWidth="1120"
                    HorizontalAlignment="Stretch" FontFamily="{DynamicResource AppFont}"/>
  </DockPanel>
</Window>
