<UserControl x:Class="HajatManager.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <!-- Header: judul + count kiri, tombol Buat kanan -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <TextBlock Text="Acara" Style="{DynamicResource M3Headline}" VerticalAlignment="Center"/>
        <TextBlock x:Name="CountText" Margin="8,0,0,0" VerticalAlignment="Center"
                   Foreground="{DynamicResource OnVariantBrush}" FontSize="12"/>
      </StackPanel>
      <Button Grid.Column="1" Content="+ Acara" Click="OnCreate"
              Style="{DynamicResource PrimaryButton}" MinWidth="120"/>
    </Grid>
    <TextBlock DockPanel.Dock="Top" Text="Pilih acara untuk input, buku tamu, dan rekap."
               Style="{DynamicResource M3SectionTitle}" Margin="0,0,0,8"/>
    <!-- Search M3 dengan hint -->
    <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
      <TextBox x:Name="SearchBox" TextChanged="OnSearch"
               Padding="36,10,12,10"/>
      <TextBlock Margin="36,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                 Foreground="{DynamicResource OnVariantBrush}" FontSize="12"
                 Text="Cari acara / lokasi… (Ctrl+F)">
        <TextBlock.Style>
          <Style TargetType="TextBlock">
            <Setter Property="Visibility" Value="Collapsed"/>
            <Style.Triggers>
              <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                <Setter Property="Visibility" Value="Visible"/>
              </DataTrigger>
            </Style.Triggers>
          </Style>
        </TextBlock.Style>
      </TextBlock>
      <TextBlock Margin="12,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                 Foreground="{DynamicResource OnVariantBrush}" FontSize="14" Text="&#xE71E;"/>
    </Grid>
    <ProgressBar x:Name="LoadingBar" DockPanel.Dock="Top" Height="4" Margin="0,0,0,8"
                 IsIndeterminate="True" Visibility="Collapsed"/>
    <Grid>
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <!-- WrapPanel = kolom fluida otomatis (cermin columnsForWidth Flutter) -->
        <ItemsControl x:Name="List">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border MinWidth="300" MaxWidth="480" Margin="0,0,12,12" Padding="16"
                      Style="{DynamicResource M3Card}"
                      Cursor="Hand" Focusable="True"
                      ToolTip="Buka acara (Enter)"
                      MouseLeftButtonUp="OnOpen" KeyDown="OnOpenKey">
                <Grid>
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="52"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <!-- Kotak tanggal ala Linux (secondaryContainer) -->
                  <Border Width="52" Height="52" CornerRadius="12" VerticalAlignment="Top"
                          Background="{DynamicResource SecondaryContainerBrush}"
                          BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1">
                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                      <TextBlock Text="{Binding Tanggal, StringFormat=dd}" FontWeight="Bold" FontSize="16"
                                 Foreground="{DynamicResource OnSecondaryContainerBrush}"
                                 HorizontalAlignment="Center"/>
                      <TextBlock Text="{Binding Tanggal, StringFormat=MMM}" FontSize="11"
                                 Foreground="{DynamicResource OnSecondaryContainerBrush}"
                                 HorizontalAlignment="Center"/>
                    </StackPanel>
                  </Border>
                  <StackPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding NamaAcara}" FontWeight="SemiBold" FontSize="15"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock Foreground="{DynamicResource OnVariantBrush}" FontSize="12"
                               TextTrimming="CharacterEllipsis">
                      <Run Text="{Binding Lokasi, TargetNullValue='-'}"/>
                      <Run Text=" • "/><Run Text="{Binding Tanggal, StringFormat=d}"/>
                    </TextBlock>
                    <TextBlock Foreground="{DynamicResource OnVariantBrush}" FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               Text="{Binding NamaTuanRumah, TargetNullValue='', StringFormat='Tuan rumah: {0}'}"/>
                    <!-- RoleChip warna per-role -->
                    <Border Margin="0,6,0,0" Padding="10,3" CornerRadius="8"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                            HorizontalAlignment="Left">
                      <Border.Style>
                        <Style TargetType="Border">
                          <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding MyRole}" Value="OWNER">
                              <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding MyRole}" Value="ADMIN">
                              <Setter Property="Background" Value="{DynamicResource WarningContainerBrush}"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </Border.Style>
                      <TextBlock Text="{Binding MyRole}" FontSize="11" FontWeight="SemiBold">
                        <TextBlock.Style>
                          <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{DynamicResource OnSurfaceBrush}"/>
                            <Style.Triggers>
                              <DataTrigger Binding="{Binding MyRole}" Value="OWNER">
                                <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}"/>
                              </DataTrigger>
                              <DataTrigger Binding="{Binding MyRole}" Value="ADMIN">
                                <Setter Property="Foreground" Value="{DynamicResource OnWarningContainerBrush}"/>
                              </DataTrigger>
                            </Style.Triggers>
                          </Style>
                        </TextBlock.Style>
                      </TextBlock>
                    </Border>
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="›" FontSize="24" VerticalAlignment="Center"
                             Foreground="{DynamicResource OnVariantBrush}" Margin="8,0,0,0"/>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
      <!-- Empty state ala Linux/Web -->
      <Border x:Name="EmptyPanel" Visibility="Collapsed" Margin="0,24,0,0"
              Style="{DynamicResource M3Card}" HorizontalAlignment="Center" VerticalAlignment="Top"
              MaxWidth="480" Padding="24">
        <StackPanel HorizontalAlignment="Center">
          <TextBlock Text="&#xE787;" FontFamily="Segoe MDL2 Assets" FontSize="40"
                     Foreground="{DynamicResource OnVariantBrush}" HorizontalAlignment="Center"/>
          <TextBlock x:Name="EmptyTitle" Text="Belum ada acara" FontWeight="SemiBold" FontSize="15"
                     HorizontalAlignment="Center" Margin="0,12,0,0"/>
          <TextBlock x:Name="EmptySub" Text="Buat acara pertama atau minta panitia menambahkanmu."
                     Foreground="{DynamicResource OnVariantBrush}" FontSize="12"
                     TextWrapping="Wrap" TextAlignment="Center" Margin="0,4,0,0"/>
          <Button x:Name="EmptyCreateBtn" Content="Buat acara pertama" Click="OnCreate"
                  Style="{DynamicResource PrimaryButton}" Margin="0,12,0,0"
                  HorizontalAlignment="Center" MinWidth="180"/>
        </StackPanel>
      </Border>
    </Grid>
  </DockPanel>
</UserControl>
