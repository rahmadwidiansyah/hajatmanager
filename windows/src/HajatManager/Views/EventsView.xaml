<UserControl x:Class="HajatManager.Views.EventsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <DockPanel>
    <TextBlock DockPanel.Dock="Top" Text="Acara" Style="{DynamicResource M3Headline}" Margin="0,0,0,2"/>
    <TextBlock DockPanel.Dock="Top" Text="Pilih acara untuk input, buku tamu, dan rekap."
               Style="{DynamicResource M3SectionTitle}" Margin="0,0,0,8"/>
    <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,12"
             TextChanged="OnSearch" Tag="Cari acara / lokasi…"/>
    <Button Content="+ Acara" DockPanel.Dock="Bottom" Margin="0,12,0,0"
            Style="{DynamicResource PrimaryButton}" Click="OnCreate"/>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
      <!-- WrapPanel = kolom fluida otomatis (cermin columnsForWidth Flutter) -->
      <ItemsControl x:Name="List">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel Orientation="Horizontal"/>
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Border Width="340" Margin="0,0,12,12" Padding="16"
                    Style="{DynamicResource M3Card}"
                    Cursor="Hand"
                    MouseLeftButtonUp="OnOpen">
              <StackPanel>
                <TextBlock Text="{Binding NamaAcara}" FontWeight="Bold" FontSize="15"/>
                <TextBlock Foreground="{DynamicResource OnVariantBrush}">
                  <Run Text="{Binding Lokasi, TargetNullValue='-'}"/>
                  <Run Text=" • "/><Run Text="{Binding Tanggal, StringFormat=d}"/>
                </TextBlock>
                <TextBlock Foreground="{DynamicResource PrimaryBrush}" FontWeight="SemiBold"
                           Text="{Binding MyRole}" Margin="0,4,0,0"/>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
