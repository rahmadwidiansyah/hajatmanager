<UserControl x:Class="HajatManager.Views.EventDetailView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Task 4: layout identik EventDetailWindow + TopBar cermin TopBar.tsx + tab Setting.
       Di-host di MainWindow.Host (embed) atau di EventDetailWindow (dialog). -->
  <DockPanel MaxWidth="1120">
    <!-- TopBar cermin TopBar.tsx: kembali + info acara + aksi kanan -->
    <Border DockPanel.Dock="Top" Background="{DynamicResource CardBrush}"
            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
            CornerRadius="10" Padding="8,6" Margin="0,0,0,6" SnapsToDevicePixels="True">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <!-- Tombol kembali ke daftar (hanya saat embed; Collapsed di dialog) -->
        <Button x:Name="BackBtn" Style="{DynamicResource TextButton}" Click="OnBack"
                Width="32" Height="32" Padding="0" FontSize="14" Visibility="Collapsed"
                VerticalAlignment="Center" ToolTip="Kembali ke daftar acara">
          <TextBlock Text="&#xE72B;" FontFamily="Segoe MDL2 Assets"
                     HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Button>
        <!-- Info: nama + meja + nominal + kasir -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="8,0,0,0">
          <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14"
                     TextTrimming="CharacterEllipsis" MaxWidth="220" VerticalAlignment="Center"/>
          <!-- Dropdown meja kasir -->
          <ComboBox x:Name="MejaBox" Margin="8,0,0,0" Width="84" VerticalAlignment="Center"
                    Padding="6,2" FontSize="12"
                    SelectionChanged="OnMejaChanged" ToolTip="Meja kasir aktif"/>
          <!-- Nominal pill (cermin nominalPill web) -->
          <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="12"
                  Background="{DynamicResource PrimaryContainerBrush}"
                  BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                  VerticalAlignment="Center" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <TextBlock Text="&#xE719;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                         Foreground="{DynamicResource OnPrimaryContainerBrush}"
                         VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock x:Name="NominalPill" Text="Rp 0" FontSize="12" FontWeight="SemiBold"
                         FontFamily="{DynamicResource NumericFont}"
                         Foreground="{DynamicResource OnPrimaryContainerBrush}"
                         VerticalAlignment="Center"/>
              <Button x:Name="HideNominalBtn" Style="{DynamicResource TextButton}"
                      Width="18" Height="18" Padding="0" Click="OnToggleHideNominal" Margin="4,0,0,0"
                      FontSize="11" ToolTip="Sembunyikan/tampilkan nominal">
                <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
              </Button>
            </StackPanel>
          </Border>
          <!-- Kasir chip -->
          <Border Margin="8,0,0,0" Padding="6,2" CornerRadius="12"
                  Background="{DynamicResource SurfaceContainerBrush}"
                  BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                  VerticalAlignment="Center" SnapsToDevicePixels="True">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{DynamicResource TertiaryBrush}"
                       VerticalAlignment="Center" Margin="0,0,4,0"/>
              <TextBlock x:Name="KasirText" Text="" FontSize="12"
                         Foreground="{DynamicResource OnVariantBrush}"
                         TextTrimming="CharacterEllipsis" MaxWidth="100"
                         VerticalAlignment="Center"/>
            </StackPanel>
          </Border>
        </StackPanel>
        <!-- Aksi kanan: role chip + sync (Export di Rekap, Log di Audit, Setting di tab) -->
        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="TopRoleChip" Padding="8,3" CornerRadius="6" Margin="0,0,8,0"
                  BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                  VerticalAlignment="Center" SnapsToDevicePixels="True">
            <Border.Style>
              <Style TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SurfaceContainerHighBrush}"/>
                <Style.Triggers>
                  <DataTrigger Binding="{Binding Text, ElementName=TopRoleText}" Value="OWNER">
                    <Setter Property="Background" Value="{DynamicResource PrimaryContainerBrush}"/>
                  </DataTrigger>
                  <DataTrigger Binding="{Binding Text, ElementName=TopRoleText}" Value="ADMIN">
                    <Setter Property="Background" Value="{DynamicResource WarningContainerBrush}"/>
                  </DataTrigger>
                </Style.Triggers>
              </Style>
            </Border.Style>
            <TextBlock x:Name="TopRoleText" Text="" FontSize="11" FontWeight="SemiBold">
              <TextBlock.Style>
                <Style TargetType="TextBlock">
                  <Setter Property="Foreground" Value="{DynamicResource OnVariantBrush}"/>
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="OWNER">
                      <Setter Property="Foreground" Value="{DynamicResource OnPrimaryContainerBrush}"/>
                    </DataTrigger>
                    <DataTrigger Binding="{Binding Text, RelativeSource={RelativeSource Self}}" Value="ADMIN">
                      <Setter Property="Foreground" Value="{DynamicResource OnWarningContainerBrush}"/>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </TextBlock.Style>
            </TextBlock>
          </Border>
          <Grid VerticalAlignment="Center">
            <Button x:Name="SyncCloudBtn" Style="{DynamicResource M3SyncButton}" Click="OnSync"
                    ToolTip="Sync data (Ctrl+R)">
              <TextBlock x:Name="SyncCloudIcon" Text="&#xE117;" FontFamily="Segoe MDL2 Assets"
                         FontSize="14" VerticalAlignment="Center" HorizontalAlignment="Center"/>
            </Button>
            <Border x:Name="SyncBadgeBorder" MinWidth="18" Height="18" CornerRadius="9"
                    Background="{DynamicResource ErrorBrush}"
                    BorderBrush="{DynamicResource SurfaceBrush}" BorderThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,-6,0"
                    Visibility="Collapsed" SnapsToDevicePixels="True">
              <TextBlock x:Name="SyncBadgeText" Text="0" FontSize="10" FontWeight="Bold"
                         Foreground="{DynamicResource OnErrorBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,0"/>
            </Border>
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
    <!-- Status sync kecil (Antre N • Online/Offline) -->
    <TextBlock x:Name="PendingText" DockPanel.Dock="Top" Margin="4,0,0,8" FontSize="12"
               Foreground="{DynamicResource OnVariantBrush}"/>
    <TabControl x:Name="Tabs">
      <TabItem Header="Input">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="InputPanel" Margin="4"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Buku Tamu">
        <DockPanel Margin="4">
          <StackPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid Margin="0,0,8,0">
                <Border Background="{DynamicResource CardBrush}"
                        BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                        CornerRadius="8" SnapsToDevicePixels="True">
                  <Grid>
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="36"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                               Foreground="{DynamicResource OnVariantBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox x:Name="BookSearch" Grid.Column="1" BorderThickness="0"
                             Background="Transparent" Padding="0,6" FontSize="13"
                             TextChanged="OnBookSearch"/>
                  </Grid>
                </Border>
                <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="42,0,0,0"
                           Foreground="{DynamicResource OnVariantBrush}" FontSize="13"
                           Text="Cari buku tamu…">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=BookSearch}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button Grid.Column="1" Content="Sync" Click="OnSync" Style="{DynamicResource OutlineButton}"
                      VerticalAlignment="Center" ToolTip="Sync data (Ctrl+R)"/>
            </Grid>
            <!-- Form tambah inline cermin web (satset, tanpa popup) -->
            <Grid x:Name="BookAddRow" Margin="0,8,0,0" Visibility="Collapsed">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <Grid>
                <TextBox x:Name="BookNamaBox" Padding="10,6" FontSize="13" ToolTip="Nama tamu (min. 2 huruf)"/>
                <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource OnVariantBrush}" FontSize="13" Text="Nama…">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=BookNamaBox}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Grid Grid.Column="1" Margin="8,0,0,0">
                <TextBox x:Name="BookAlamatBox" Padding="10,6" FontSize="13" ToolTip="Alamat/desa (min. 2 huruf)"/>
                <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="12,0,0,0"
                           Foreground="{DynamicResource OnVariantBrush}" FontSize="13" Text="Alamat…">
                  <TextBlock.Style>
                    <Style TargetType="TextBlock">
                      <Setter Property="Visibility" Value="Collapsed"/>
                      <Style.Triggers>
                        <DataTrigger Binding="{Binding Text, ElementName=BookAlamatBox}" Value="">
                          <Setter Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                      </Style.Triggers>
                    </Style>
                  </TextBlock.Style>
                </TextBlock>
              </Grid>
              <Button x:Name="BookSaveBtn" Grid.Column="2" Content="Simpan" Click="OnAddBook"
                      Margin="8,0,0,0" Style="{DynamicResource PrimaryButton}"
                      VerticalAlignment="Center" ToolTip="Simpan buku tamu (Enter)"/>
            </Grid>
            <TextBlock x:Name="BookAddErr" Foreground="{DynamicResource ErrorBrush}" FontSize="12"
                       TextWrapping="Wrap" Margin="0,4,0,0" Visibility="Collapsed"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                      VerticalAlignment="Center">
            <TextBlock x:Name="BookFooter" VerticalAlignment="Center"
                       Foreground="{DynamicResource OnVariantBrush}"/>
            <Button x:Name="BookMoreBtn" Content="Muat 50 lagi" Margin="12,0,0,0" Click="OnBookMore"
                    Style="{DynamicResource OutlineButton}" Visibility="Collapsed" ToolTip="Muat 50 lagi"/>
          </StackPanel>
          <DataGrid x:Name="BooksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding No}" Width="50"/>
              <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
              <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="*"/>
              <DataGridTemplateColumn Header="Aksi" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Edit" Click="OnEditBook" Tag="{Binding}"
                              Margin="0,0,4,0" Padding="8,2" ToolTip="Edit data"/>
                      <Button Content="Hapus" Click="OnDeleteBook" Padding="8,2" ToolTip="Hapus data"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Rekap">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <Border Padding="16" Margin="0,0,0,12" Style="{DynamicResource M3Card}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                  <TextBlock x:Name="TotalTamuText" FontSize="14"
                             Foreground="{DynamicResource OnVariantBrush}"/>
                  <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TotalNominalText" FontSize="24" FontWeight="Bold"
                               FontFamily="{DynamicResource NumericFont}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis"/>
                    <Button x:Name="HideRekapNominalBtn" Style="{DynamicResource TextButton}"
                            Width="24" Height="24" Padding="0" Click="OnToggleHideNominal" Margin="8,0,0,0"
                            FontSize="12" ToolTip="Sembunyikan/tampilkan nominal" VerticalAlignment="Center">
                      <TextBlock Text="&#xE7B3;" FontFamily="Segoe MDL2 Assets"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Button>
                  </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="Export PDF / Excel" Click="OnExport"
                        Style="{DynamicResource PrimaryButton}" VerticalAlignment="Center"
                        ToolTip="Export PDF / Excel"/>
              </Grid>
            </Border>
            <UniformGrid x:Name="RekapGrid" Columns="2" Margin="0,8,0,0">
              <!-- Per Meja — bar biru tertiary cermin web -->
              <Border Style="{DynamicResource M3Card}" Margin="0,0,6,6">
                <StackPanel>
                  <TextBlock Text="PER MEJA" Style="{DynamicResource M3SectionTitle}"/>
                  <Border Padding="8,3" CornerRadius="6" Margin="0,0,0,8"
                          Background="{DynamicResource TertiaryContainerBrush}"
                          BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                          HorizontalAlignment="Left" SnapsToDevicePixels="True">
                    <TextBlock Text="Lokasi fisik" FontSize="11"
                               Foreground="{DynamicResource OnTertiaryContainerBrush}"/>
                  </Border>
                  <TextBlock x:Name="MejaEmpty" Text="Belum ada data" FontSize="12"
                             Foreground="{DynamicResource OnVariantBrush}" Visibility="Collapsed"/>
                  <ItemsControl x:Name="MejaList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalRp}" FontWeight="Bold"
                                       FontSize="13" FontFamily="{DynamicResource NumericFont}"
                                       Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource OnTertiaryContainerBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Top}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                          <Grid Height="6" Margin="0,4,0,0" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding Fill}"/>
                              <ColumnDefinition Width="{Binding Rest}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3"
                                    Background="{DynamicResource TertiaryBrush}">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="{DynamicResource TertiaryBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Top}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="3"
                                    Background="{DynamicResource SurfaceContainerBrush}"/>
                          </Grid>
                          <Grid Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Sub}" FontSize="11"
                                       Foreground="{DynamicResource OnVariantBrush}"/>
                            <TextBlock Grid.Column="1" Text="{Binding PctText}" FontSize="11"
                                       Foreground="{DynamicResource OnVariantBrush}"/>
                          </Grid>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <!-- Per Kasir — bar amber cermin web -->
              <Border Style="{DynamicResource M3Card}" Margin="6,0,0,6">
                <StackPanel>
                  <TextBlock Text="PER KASIR" Style="{DynamicResource M3SectionTitle}"/>
                  <Border Padding="8,3" CornerRadius="6" Margin="0,0,0,8"
                          Background="{DynamicResource WarningContainerBrush}"
                          BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                          HorizontalAlignment="Left" SnapsToDevicePixels="True">
                    <TextBlock Text="Petugas" FontSize="11"
                               Foreground="{DynamicResource OnWarningContainerBrush}"/>
                  </Border>
                  <TextBlock x:Name="KasirEmpty" Text="Belum ada data" FontSize="12"
                             Foreground="{DynamicResource OnVariantBrush}" Visibility="Collapsed"/>
                  <ItemsControl x:Name="KasirList">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate>
                        <StackPanel Margin="0,0,0,10">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="*"/>
                              <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding Label}" FontWeight="Medium" FontSize="13"
                                       TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="1" Text="{Binding TotalRp}" FontWeight="Bold"
                                       FontSize="13" FontFamily="{DynamicResource NumericFont}"
                                       Margin="8,0,0,0" VerticalAlignment="Center">
                              <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                  <Setter Property="Foreground" Value="{DynamicResource OnWarningContainerBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Top}" Value="True">
                                      <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </TextBlock.Style>
                            </TextBlock>
                          </Grid>
                          <Grid Height="6" Margin="0,4,0,0" SnapsToDevicePixels="True">
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="{Binding Fill}"/>
                              <ColumnDefinition Width="{Binding Rest}"/>
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" CornerRadius="3">
                              <Border.Style>
                                <Style TargetType="Border">
                                  <Setter Property="Background" Value="{DynamicResource WarningBrush}"/>
                                  <Style.Triggers>
                                    <DataTrigger Binding="{Binding Top}" Value="True">
                                      <Setter Property="Background" Value="{DynamicResource PrimaryBrush}"/>
                                    </DataTrigger>
                                  </Style.Triggers>
                                </Style>
                              </Border.Style>
                            </Border>
                            <Border Grid.Column="1" CornerRadius="3"
                                    Background="{DynamicResource SurfaceContainerBrush}"/>
                          </Grid>
                          <TextBlock Text="{Binding Sub}" FontSize="11" Margin="0,2,0,0"
                                     Foreground="{DynamicResource OnVariantBrush}"/>
                        </StackPanel>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </Border>
              <!-- Per Metode -->
              <Border Style="{DynamicResource M3Card}" Margin="0,0,6,0">
                <StackPanel>
                  <TextBlock Text="PER METODE" Style="{DynamicResource M3SectionTitle}"/>
                  <DataGrid x:Name="MetodeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                            HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Metode" Binding="{Binding Label}" Width="*"/>
                  <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80"/>
                  <DataGridTextColumn Header="Total" Binding="{Binding TotalRp}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{DynamicResource NumericFont}"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                  <DataGridTextColumn Header="Porsi" Binding="{Binding Porsi}" Width="70"/>
                </DataGrid.Columns>
              </DataGrid>
                </StackPanel>
              </Border>
              <!-- Per Alamat -->
              <Border Style="{DynamicResource M3Card}" Margin="6,0,0,0">
                <StackPanel>
                  <TextBlock Text="PER ALAMAT" Style="{DynamicResource M3SectionTitle}"/>
                  <DataGrid x:Name="AlamatGrid" AutoGenerateColumns="False" IsReadOnly="True"
                            HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Alamat" Binding="{Binding Label}" Width="*"/>
                  <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80"/>
                  <DataGridTextColumn Header="Total" Binding="{Binding TotalRp}" Width="130">
                    <DataGridTextColumn.ElementStyle>
                      <Style TargetType="TextBlock">
                        <Setter Property="FontFamily" Value="{DynamicResource NumericFont}"/>
                        <Setter Property="HorizontalAlignment" Value="Right"/>
                      </Style>
                    </DataGridTextColumn.ElementStyle>
                  </DataGridTextColumn>
                </DataGrid.Columns>
              </DataGrid>
                </StackPanel>
              </Border>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
      <!-- Tab ke-4: pengaturan acara cermin tab setting web (Task 7) -->
      <TabItem Header="Setting">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="SettingPanel" Margin="4">
            <GroupBox Header="Info Acara" Margin="0,0,0,6">
              <StackPanel>
                <UniformGrid Columns="2">
                  <StackPanel Margin="0,0,6,0">
                    <TextBlock Text="NAMA ACARA" Style="{DynamicResource M3SectionTitle}"/>
                    <TextBox x:Name="SettingNamaBox" Margin="0,0,0,8"/>
                    <TextBlock Text="TUAN RUMAH *" Style="{DynamicResource M3SectionTitle}"/>
                    <TextBox x:Name="SettingTuanBox" Margin="0,0,0,8"/>
                    <TextBlock Text="TANGGAL" Style="{DynamicResource M3SectionTitle}"/>
                    <DatePicker x:Name="SettingTglPicker"/>
                  </StackPanel>
                  <StackPanel Margin="6,0,0,0">
                    <TextBlock Text="LOKASI" Style="{DynamicResource M3SectionTitle}"/>
                    <TextBox x:Name="SettingLokBox" Margin="0,0,0,8"/>
                    <TextBlock Text="CATATAN" Style="{DynamicResource M3SectionTitle}"/>
                    <TextBox x:Name="SettingCatBox" AcceptsReturn="True" Height="80"
                             VerticalContentAlignment="Top"/>
                  </StackPanel>
                </UniformGrid>
                <TextBlock x:Name="SettingViewerNote" FontSize="12" Margin="0,6,0,0"
                           Foreground="{DynamicResource OnVariantBrush}" Visibility="Collapsed"
                           Text="Hanya OWNER/ADMIN yang bisa mengubah info acara."/>
                <Button x:Name="SettingSaveBtn" Content="Simpan Perubahan (Ctrl+S)"
                        Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right"
                        Margin="0,8,0,0" Click="OnSaveInfo"
                        ToolTip="Simpan info acara (Ctrl+S)"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Meja (maks 10)" Margin="0,0,0,6">
              <StackPanel>
                <WrapPanel x:Name="SettingMejaChips" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal">
                  <TextBox x:Name="SettingMejaBox" Width="150" VerticalAlignment="Center"
                           ToolTip="Nama meja baru, mis. MEJA-3"/>
                  <Button Content="+ Tambah" Click="OnAddSettingMeja" Margin="8,0,0,0"
                          Style="{DynamicResource OutlineButton}" VerticalAlignment="Center"
                          ToolTip="Tambah meja"/>
                </StackPanel>
              </StackPanel>
            </GroupBox>
            <GroupBox x:Name="SettingMemberBox" Header="Anggota" Margin="0,0,0,6">
              <StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                  <Grid Width="220" VerticalAlignment="Center">
                    <Border Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                            CornerRadius="8" SnapsToDevicePixels="True">
                      <Grid>
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="32"/>
                          <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                   Foreground="{DynamicResource OnVariantBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        <TextBox x:Name="SettingUserSearch" Grid.Column="1" BorderThickness="0"
                                 Background="Transparent" Padding="0,6" FontSize="13"
                                 TextChanged="OnSettingUserSearch" ToolTip="Cari user (min. 2 huruf)"/>
                      </Grid>
                    </Border>
                    <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="36,0,0,0"
                               Foreground="{DynamicResource OnVariantBrush}" FontSize="12"
                               Text="Cari user…">
                      <TextBlock.Style>
                        <Style TargetType="TextBlock">
                          <Setter Property="Visibility" Value="Collapsed"/>
                          <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SettingUserSearch}" Value="">
                              <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                          </Style.Triggers>
                        </Style>
                      </TextBlock.Style>
                    </TextBlock>
                  </Grid>
                  <ComboBox x:Name="SettingRoleBox" Width="96" Margin="8,0,0,0"
                            Padding="6,2" FontSize="12"
                            VerticalAlignment="Center" ToolTip="Role anggota baru">
                    <ComboBoxItem Content="ADMIN" IsSelected="True"/>
                    <ComboBoxItem Content="OWNER"/>
                    <ComboBoxItem Content="VIEWER"/>
                  </ComboBox>
                  <Button Content="+ Tambah" Click="OnAddSettingMember" Margin="8,0,0,0"
                          Style="{DynamicResource OutlineButton}" VerticalAlignment="Center"
                          ToolTip="Tambah anggota terpilih"/>
                </StackPanel>
                <ListBox x:Name="SettingResultList" MaxHeight="120" Margin="0,0,0,8"
                         MouseDoubleClick="OnAddSettingMemberDbl"/>
                <!-- Daftar anggota cermin web: avatar + nama + chip role + email -->
                <StackPanel x:Name="SettingMemberList"/>
              </StackPanel>
            </GroupBox>
            <GroupBox Header="Audit Log" Margin="0,0,0,6">
              <StackPanel>
                <Grid Margin="0,0,0,8">
                  <Border Background="{DynamicResource CardBrush}"
                          BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                          CornerRadius="8" SnapsToDevicePixels="True">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="32"/>
                        <ColumnDefinition Width="*"/>
                      </Grid.ColumnDefinitions>
                      <TextBlock Text="&#xE71E;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                 Foreground="{DynamicResource OnVariantBrush}"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"/>
                      <TextBox x:Name="LogSearchBox" Grid.Column="1" BorderThickness="0"
                               Background="Transparent" Padding="0,6" FontSize="13"
                               TextChanged="OnLogSearch" ToolTip="Cari log…"/>
                    </Grid>
                  </Border>
                  <TextBlock IsHitTestVisible="False" VerticalAlignment="Center" Margin="36,0,0,0"
                             Foreground="{DynamicResource OnVariantBrush}" FontSize="12"
                             Text="Cari log…">
                    <TextBlock.Style>
                      <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                          <DataTrigger Binding="{Binding Text, ElementName=LogSearchBox}" Value="">
                            <Setter Property="Visibility" Value="Visible"/>
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </TextBlock.Style>
                  </TextBlock>
                </Grid>
                <DataGrid x:Name="AuditGrid" AutoGenerateColumns="False" IsReadOnly="True"
                          MaxHeight="250" HeadersVisibility="Column">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Waktu" Binding="{Binding Waktu}" Width="130"/>
                    <DataGridTextColumn Header="User" Binding="{Binding User}" Width="120"/>
                    <DataGridTextColumn Header="Aksi" Binding="{Binding Aksi}" Width="*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </StackPanel>
            </GroupBox>
            <Border Style="{DynamicResource M3DangerZone}" Margin="0,2,0,0">
              <StackPanel>
                <TextBlock Text="Zona Berbahaya" FontWeight="SemiBold"
                           Foreground="{DynamicResource ErrorBrush}" Margin="0,0,0,4"/>
                <TextBlock Text="Tindakan ini tidak bisa dibatalkan." FontSize="12"
                           Foreground="{DynamicResource OnVariantBrush}" Margin="0,0,0,8"/>
                <Button x:Name="DeleteBtn" Content="Hapus Acara Permanen"
                        Style="{DynamicResource DangerButton}" Click="OnDelete"
                        HorizontalAlignment="Left"
                        ToolTip="Hapus acara ini permanen (tidak bisa dibatalkan)"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</UserControl>
