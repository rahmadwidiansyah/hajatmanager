<UserControl x:Class="HajatManager.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- Fase 5: page-shell cermin web (dulu 700, terlalu sempit di desktop) -->
    <StackPanel Margin="16" MaxWidth="1120">
      <TextBlock Text="Akun" Style="{DynamicResource M3Headline}" Margin="0,0,0,12"/>
      <Border Style="{DynamicResource M3Card}">
        <StackPanel>
          <TextBlock x:Name="NameText" FontWeight="Bold" FontSize="16"/>
          <TextBlock x:Name="EmailText" Foreground="{DynamicResource OnVariantBrush}"/>
        </StackPanel>
      </Border>
      <!-- Pilihan Terang/Gelap/Sistem, berlaku instan -->
      <Border Margin="0,12,0,0" Style="{DynamicResource M3Card}">
        <StackPanel>
          <TextBlock Text="Tampilan" FontWeight="SemiBold"/>
          <TextBlock Text="Terang, gelap, atau ikut sistem" FontSize="12"
                     Foreground="{DynamicResource OnVariantBrush}" Margin="0,2,0,8"/>
          <StackPanel Orientation="Horizontal">
            <RadioButton x:Name="ThemeLight" Content="Terang" GroupName="Theme"
                         Margin="0,0,16,0" Tag="light" Checked="OnThemeChecked"/>
            <RadioButton x:Name="ThemeDark" Content="Gelap" GroupName="Theme"
                         Margin="0,0,16,0" Tag="dark" Checked="OnThemeChecked"/>
            <RadioButton x:Name="ThemeSystem" Content="Sistem" GroupName="Theme"
                         Tag="system" Checked="OnThemeChecked"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- Segmented M3: satu gaya chip, aktif ikut SubHost -->
      <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
        <Button x:Name="ProfilBtn" Content="Profil" Click="GoProfile" Style="{DynamicResource M3ChipActive}"/>
        <Button x:Name="KeamananBtn" Content="Keamanan &amp; Password" Click="GoSecurity" Style="{DynamicResource M3Chip}"/>
        <Button x:Name="PinBtn" Content="PIN &amp; Kunci Layar" Click="GoPin" Style="{DynamicResource M3Chip}"/>
        <Button x:Name="TentangBtn" Content="Tentang &amp; Keluar" Click="GoAbout" Style="{DynamicResource M3Chip}"/>
      </StackPanel>
      <ContentControl x:Name="SubHost" Margin="0,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
