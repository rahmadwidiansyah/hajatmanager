<UserControl x:Class="HajatManager.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="8" MaxWidth="700">
      <Border Padding="16" Background="{StaticResource CardBrush}"
              BorderBrush="{StaticResource OutlineBrush}" BorderThickness="1" CornerRadius="12">
        <StackPanel>
          <TextBlock x:Name="NameText" FontWeight="Bold" FontSize="16"/>
          <TextBlock x:Name="EmailText" Foreground="{StaticResource OnVariantBrush}"/>
        </StackPanel>
      </Border>
      <UniformGrid Columns="2" Margin="0,12,0,0">
        <Button Content="Profil" Click="GoProfile" Margin="0,0,6,6" Padding="12"/>
        <Button Content="Keamanan &amp; Password" Click="GoSecurity" Margin="6,0,0,6" Padding="12"/>
        <Button Content="PIN &amp; Kunci Layar" Click="GoPin" Margin="0,6,6,0" Padding="12"/>
        <Button Content="Tentang &amp; Keluar" Click="GoAbout" Margin="6,6,0,0" Padding="12"/>
      </UniformGrid>
      <ContentControl x:Name="SubHost" Margin="0,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
