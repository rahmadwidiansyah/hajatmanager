<UserControl x:Class="HajatManager.Views.AccountView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <!-- Fase 5: page-shell cermin web (dulu 700, terlalu sempit di desktop) -->
    <StackPanel Margin="16" MaxWidth="1120">
      <TextBlock Text="Akun" Style="{DynamicResource M3Headline}" Margin="0,0,0,12"/>
      <!-- Kartu profil cermin Flutter (avatar + nama + email) -->
      <Border Style="{DynamicResource M3Card}">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <Border x:Name="AvatarCircle" Width="52" Height="52" CornerRadius="26"
                  Background="{DynamicResource PrimaryContainerBrush}"
                  VerticalAlignment="Center">
            <TextBlock x:Name="AvatarText" Text="?" FontWeight="Bold" FontSize="20"
                       Foreground="{DynamicResource OnPrimaryContainerBrush}"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
          </Border>
          <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="NameText" FontWeight="Bold" FontSize="16"/>
            <TextBlock x:Name="EmailText" Foreground="{DynamicResource OnVariantBrush}"/>
          </StackPanel>
        </StackPanel>
      </Border>
      <!-- Pilihan Terang/Gelap/Sistem via Segmented cermin Flutter -->
      <Border Margin="0,12,0,0" Style="{DynamicResource M3Card}">
        <StackPanel>
          <TextBlock Text="Tampilan" FontWeight="SemiBold"/>
          <TextBlock Text="Terang, gelap, atau ikut sistem" FontSize="12"
                     Foreground="{DynamicResource OnVariantBrush}" Margin="0,2,0,8"/>
          <ContentControl x:Name="ThemeSegHost" HorizontalAlignment="Left"/>
        </StackPanel>
      </Border>
      <!-- Tiles 2 kolom cermin Flutter (leading ikon + chevron) -->
      <UniformGrid x:Name="TileGrid" Columns="2" Margin="0,12,0,0">
        <Border x:Name="TileProfil" Style="{DynamicResource M3Card}" Margin="0,0,6,6"
                Cursor="Hand" Focusable="True" ToolTip="Profil"
                MouseLeftButtonUp="GoProfile" KeyDown="OnTileKey">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{DynamicResource SecondaryContainerBrush}" VerticalAlignment="Center">
              <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{DynamicResource OnSecondaryContainerBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Profil" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource OnVariantBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="TileKeamanan" Style="{DynamicResource M3Card}" Margin="6,0,0,6"
                Cursor="Hand" Focusable="True" ToolTip="Keamanan &amp; Password"
                MouseLeftButtonUp="GoSecurity" KeyDown="OnTileKey">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{DynamicResource SecondaryContainerBrush}" VerticalAlignment="Center">
              <TextBlock Text="&#xE72E;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{DynamicResource OnSecondaryContainerBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Keamanan &amp; Password" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource OnVariantBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="TilePin" Style="{DynamicResource M3Card}" Margin="0,0,6,0"
                Cursor="Hand" Focusable="True" ToolTip="PIN &amp; Kunci Layar"
                MouseLeftButtonUp="GoPin" KeyDown="OnTileKey">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{DynamicResource SecondaryContainerBrush}" VerticalAlignment="Center">
              <TextBlock Text="&#xE75F;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{DynamicResource OnSecondaryContainerBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="PIN &amp; Kunci Layar" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource OnVariantBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </Border>
        <Border x:Name="TileTentang" Style="{DynamicResource M3Card}" Margin="6,0,0,0"
                Cursor="Hand" Focusable="True" ToolTip="Tentang &amp; Keluar"
                MouseLeftButtonUp="GoAbout" KeyDown="OnTileKey">
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="40" Height="40" CornerRadius="12"
                    Background="{DynamicResource SecondaryContainerBrush}" VerticalAlignment="Center">
              <TextBlock Text="&#xE946;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                         Foreground="{DynamicResource OnSecondaryContainerBrush}"
                         HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="Tentang &amp; Keluar" FontWeight="SemiBold" Margin="12,0,0,0" VerticalAlignment="Center"/>
            <TextBlock Text="&#xE76C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                       Foreground="{DynamicResource OnVariantBrush}" VerticalAlignment="Center" Margin="8,0,0,0"/>
          </StackPanel>
        </Border>
      </UniformGrid>
      <ContentControl x:Name="SubHost" Margin="0,12,0,0"/>
    </StackPanel>
  </ScrollViewer>
</UserControl>
