<Window x:Class="HajatManager.Views.EventDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Detail Acara" Height="720" Width="1100"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">
  <!-- Fase 5: page-shell cermin web (max 1120px, auto-center) -->
  <DockPanel Margin="16" MaxWidth="1120">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
      <TextBlock x:Name="TitleText" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
      <Border Margin="12,0,0,0" Padding="10,4" CornerRadius="8" VerticalAlignment="Center"
              Background="{DynamicResource SurfaceContainerBrush}">
        <TextBlock x:Name="RoleText" FontWeight="SemiBold"/>
      </Border>
      <TextBlock x:Name="PendingText" Margin="12,0,0,0" VerticalAlignment="Center"
                 Foreground="{DynamicResource OnVariantBrush}"/>
      <!-- Tombol awan sync cermin web TopBar: hijau=tersinkron, kuning=ada antre,
           abu=offline + badge jumlah pending. Klik = sync sekarang. -->
      <Button x:Name="SyncCloudBtn" Margin="12,0,0,0" Click="OnSync"
              Style="{DynamicResource TonalButton}" VerticalAlignment="Center"
              ToolTip="Sudah tersinkron — klik untuk refresh">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
          <TextBlock x:Name="SyncCloudIcon" Text="&#xE117;" FontFamily="Segoe MDL2 Assets" FontSize="14" VerticalAlignment="Center"/>
          <Border x:Name="SyncBadgeBorder" Margin="6,0,0,0" Padding="6,1" CornerRadius="8"
                  Background="{DynamicResource ErrorBrush}" Visibility="Collapsed"
                  VerticalAlignment="Center">
            <TextBlock x:Name="SyncBadgeText" Text="0" FontSize="11" FontWeight="Bold"
                       Foreground="{DynamicResource OnErrorBrush}" VerticalAlignment="Center"/>
          </Border>
        </StackPanel>
      </Button>
      <Button Content="Log" Margin="12,0,0,0" Click="OnOpenLog" Style="{DynamicResource TonalButton}"/>
      <Button Content="Pengaturan" Margin="8,0,0,0" Click="OnOpenSettings" Style="{DynamicResource OutlineButton}"/>
    </StackPanel>
    <TabControl x:Name="Tabs">
      <TabItem Header="Input">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel x:Name="InputPanel" Margin="4"/>
        </ScrollViewer>
      </TabItem>
      <TabItem Header="Buku Tamu">
        <DockPanel Margin="4">
          <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,12">
            <TextBox x:Name="BookSearch" Width="300" TextChanged="OnBookSearch"/>
            <Button x:Name="AddBookBtn" Content="+ Tamu" Margin="8,0,0,0" Click="OnAddBook"
                    Style="{DynamicResource PrimaryButton}"/>
            <Button Content="Sync" Margin="8,0,0,0" Click="OnSync" Style="{DynamicResource OutlineButton}"/>
          </StackPanel>
          <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0"
                      VerticalAlignment="Center">
            <TextBlock x:Name="BookFooter" VerticalAlignment="Center"
                       Foreground="{DynamicResource OnVariantBrush}"/>
            <Button x:Name="BookMoreBtn" Content="Muat 50 lagi" Margin="12,0,0,0" Click="OnBookMore"
                    Style="{DynamicResource OutlineButton}" Visibility="Collapsed"/>
          </StackPanel>
          <DataGrid x:Name="BooksGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    SelectionMode="Single" HeadersVisibility="Column">
            <DataGrid.Columns>
              <DataGridTextColumn Header="#" Binding="{Binding No}" Width="50"/>
              <DataGridTextColumn Header="Nama" Binding="{Binding Nama}" Width="*"/>
              <DataGridTextColumn Header="Alamat" Binding="{Binding Alamat}" Width="*"/>
              <DataGridTemplateColumn Header="Aksi" Width="110">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Edit" Click="OnEditBook" Tag="{Binding}"
                              Margin="0,0,4,0" Padding="8,2"/>
                      <Button Content="Hapus" Click="OnDeleteBook" Padding="8,2"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </DockPanel>
      </TabItem>
      <TabItem Header="Rekap">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Margin="4">
            <Border Padding="20" Style="{DynamicResource M3Card}">
              <StackPanel HorizontalAlignment="Center">
                <TextBlock x:Name="TotalTamuText" FontSize="20" TextAlignment="Center"
                           FontFamily="{DynamicResource NumericFont}"/>
                <TextBlock x:Name="TotalNominalText" FontSize="26" FontWeight="Bold"
                           TextAlignment="Center" FontFamily="{DynamicResource NumericFont}"/>
                <Button Content="Export PDF / Excel" Margin="0,12,0,0" Click="OnExport"
                        Style="{DynamicResource PrimaryButton}"/>
              </StackPanel>
            </Border>
            <UniformGrid x:Name="RekapGrid" Columns="2" Margin="0,12,0,0">
              <DataGrid x:Name="AlamatGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        Margin="0,0,6,0" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Alamat" Binding="{Binding Label}" Width="*"/>
                  <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80"/>
                  <DataGridTextColumn Header="Total" Binding="{Binding TotalRp}" Width="130"/>
                </DataGrid.Columns>
              </DataGrid>
              <DataGrid x:Name="MetodeGrid" AutoGenerateColumns="False" IsReadOnly="True"
                        Margin="6,0,0,0" HeadersVisibility="Column">
                <DataGrid.Columns>
                  <DataGridTextColumn Header="Metode" Binding="{Binding Label}" Width="*"/>
                  <DataGridTextColumn Header="Jumlah" Binding="{Binding Jumlah}" Width="80"/>
                  <DataGridTextColumn Header="Total" Binding="{Binding TotalRp}" Width="130"/>
                </DataGrid.Columns>
              </DataGrid>
            </UniformGrid>
          </StackPanel>
        </ScrollViewer>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
