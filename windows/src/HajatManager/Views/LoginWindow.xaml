<Window x:Class="HajatManager.Views.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Hajat Manager" Height="640" Width="480"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="24" MaxWidth="400" VerticalAlignment="Center">
      <!-- Ikon app cermin Flutter (72px). Judul di title-bar chrome. -->
      <Image Source="/HajatManager;component/Assets/app.ico" Width="64" Height="64"
             HorizontalAlignment="Center" Margin="0,0,0,8" Stretch="Uniform"/>
      <TextBlock Text="Catat pemberian satset, online maupun offline."
                 Foreground="{DynamicResource OnVariantBrush}" TextAlignment="Center"
                 Margin="0,0,0,12" TextWrapping="Wrap"/>

      <TextBlock Text="NAMA" Style="{DynamicResource M3SectionTitle}" x:Name="NameLabel" Visibility="Collapsed"/>
      <TextBox x:Name="NameBox" Visibility="Collapsed" Margin="0,0,0,8"/>

      <TextBlock Text="EMAIL" Style="{DynamicResource M3SectionTitle}"/>
      <TextBox x:Name="EmailBox" Margin="0,0,0,8"/>

      <TextBlock Text="PASSWORD (MIN 6)" Style="{DynamicResource M3SectionTitle}"/>
      <PasswordBox x:Name="PassBox" Margin="0,0,0,12"/>

      <Button x:Name="SubmitBtn" Content="Masuk" Style="{DynamicResource PrimaryButton}"
              Click="OnSubmit" Margin="0,0,0,8"/>
      <Button Content="Belum punya akun? Daftar" Click="OnToggleReg"
              Style="{DynamicResource TextButton}"/>

      <!-- Fase 4: Google desktop via browser (visible bila server mendukung) -->
      <StackPanel x:Name="GooglePanel" Visibility="Collapsed" Margin="0,12,0,0">
        <Grid Margin="0,0,0,8">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <Separator Grid.Column="0" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="1" Text="atau" Margin="12,0"
                     Foreground="{DynamicResource OnVariantBrush}" VerticalAlignment="Center"/>
          <Separator Grid.Column="2" VerticalAlignment="Center"/>
        </Grid>
        <Button x:Name="GoogleBtn" Content="Lanjutkan dengan Google" Click="OnGoogle"
                Style="{DynamicResource OutlineButton}"/>
        <Button Content="Punya kode Google manual? Tempel di sini" Click="OnPasteCode"
                Style="{DynamicResource TextButton}"
                FontSize="11" Margin="0,4,0,0"/>
      </StackPanel>

      <TextBlock x:Name="ErrText" Foreground="{DynamicResource ErrorBrush}"
                 TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>

      <Separator Margin="0,12"/>
      <TextBlock x:Name="ServerLabel" Text="Server (…)" Style="{DynamicResource M3SectionTitle}" Margin="0,0,0,6"/>
      <DockPanel>
        <Button Content="Tes" Click="OnTestServer" DockPanel.Dock="Right"
                Margin="8,0,0,0" Style="{DynamicResource TonalButton}"/>
        <TextBox x:Name="ServerBox" Text="https://hajat.sanding.online"/>
      </DockPanel>
      <TextBlock Text="Default: https://hajat.sanding.online — tap Tes dulu sebelum masuk."
                 FontSize="11" Foreground="{DynamicResource OnVariantBrush}"
                 TextWrapping="Wrap" Margin="0,4,0,0"/>
    </StackPanel>
  </ScrollViewer>
</Window>
