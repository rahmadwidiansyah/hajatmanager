<Window x:Class="HajatManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Acara" Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" MaxWidth="760">
      <TextBlock x:Name="SummaryText" FontWeight="Bold" Margin="0,0,0,12"/>
      <GroupBox Header="Info Acara" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBlock Text="Nama acara"/>
          <TextBox x:Name="NamaBox" Margin="0,0,0,8"/>
          <TextBlock Text="Tuan rumah"/>
          <TextBox x:Name="TuanBox" Margin="0,0,0,8"/>
          <TextBlock Text="Lokasi"/>
          <TextBox x:Name="LokBox" Margin="0,0,0,8"/>
          <TextBlock Text="Catatan"/>
          <TextBox x:Name="CatBox" Margin="0,0,0,8"/>
          <Button x:Name="SaveInfoBtn" Content="Simpan Perubahan"
                  Style="{DynamicResource PrimaryButton}" Click="OnSaveInfo"/>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="Meja" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <ListBox x:Name="MejaList" Height="110"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="MejaBox" Width="220"/>
            <Button Content="Tambah" Margin="8,0,0,0" Click="OnAddMeja"/>
          </StackPanel>
        </StackPanel>
      </GroupBox>
      <GroupBox x:Name="MemberBox" Header="Anggota (OWNER)" Padding="12" Margin="0,0,0,12">
        <StackPanel>
          <TextBox x:Name="SearchBox" TextChanged="OnSearch"/>
          <TextBlock FontSize="11" Foreground="{DynamicResource OnVariantBrush}"
                     Margin="0,2,0,0">Ketik min 2 huruf, double-click hasil untuk tambah (role ADMIN).</TextBlock>
          <ListBox x:Name="ResultList" Height="100" Margin="0,4,0,0"
                   MouseDoubleClick="OnAddMember"/>
          <DataGrid x:Name="MemberGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Margin="0,8,0,0" HeadersVisibility="Column" MaxHeight="250">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </GroupBox>
      <Button x:Name="DeleteBtn" Content="Hapus Acara Permanen" Click="OnDelete"
              Background="{DynamicResource ErrorBrush}" Foreground="White"
              Padding="16,10" FontWeight="SemiBold"/>
    </StackPanel>
  </ScrollViewer>
</Window>
