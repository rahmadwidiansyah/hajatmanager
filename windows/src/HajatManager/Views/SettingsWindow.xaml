<Window x:Class="HajatManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Acara" Height="700" Width="800"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">
  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="16" MaxWidth="760">
      <!-- Header + RoleChip cermin Flutter AppBar -->
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,0,6">
        <TextBlock x:Name="SummaryText" Style="{DynamicResource M3Headline}" VerticalAlignment="Center"/>
        <Border x:Name="RoleChip" Margin="12,0,0,0" Padding="10,4" CornerRadius="6"
                BorderBrush="{DynamicResource OutlineBrush}" BorderThickness="1"
                VerticalAlignment="Center"
                Background="{DynamicResource SurfaceContainerHighBrush}">
          <TextBlock x:Name="RoleChipText" FontSize="11" FontWeight="SemiBold"
                     Foreground="{DynamicResource OnSurfaceBrush}"/>
        </Border>
      </StackPanel>
      <ProgressBar x:Name="LoadingBar" Height="4" Margin="0,0,0,6"
                   IsIndeterminate="True" Visibility="Collapsed"/>
      <GroupBox Header="Info Acara" Margin="0,0,0,6">
        <StackPanel>
          <!-- 2 kolom di layar lebar cermin Flutter -->
          <UniformGrid Columns="2" Margin="0,0,0,0">
            <StackPanel Margin="0,0,6,0">
              <TextBlock Text="NAMA ACARA" Style="{DynamicResource M3SectionTitle}"/>
              <TextBox x:Name="NamaBox" Margin="0,0,0,6"/>
              <TextBlock Text="TUAN RUMAH" Style="{DynamicResource M3SectionTitle}"/>
              <TextBox x:Name="TuanBox" Margin="0,0,0,6"/>
              <TextBlock Text="TANGGAL" Style="{DynamicResource M3SectionTitle}"/>
              <DatePicker x:Name="TglPicker" Margin="0,0,0,6"/>
            </StackPanel>
            <StackPanel Margin="6,0,0,0">
              <TextBlock Text="LOKASI" Style="{DynamicResource M3SectionTitle}"/>
              <TextBox x:Name="LokBox" Margin="0,0,0,6"/>
              <TextBlock Text="CATATAN" Style="{DynamicResource M3SectionTitle}"/>
              <TextBox x:Name="CatBox" Margin="0,0,0,6" AcceptsReturn="True" Height="64"
                       VerticalContentAlignment="Top"/>
            </StackPanel>
          </UniformGrid>
          <TextBlock x:Name="ViewerNote" FontSize="12"
                     Foreground="{DynamicResource OnVariantBrush}" Visibility="Collapsed"
                     Margin="0,0,0,6">Hanya OWNER/ADMIN yang bisa mengubah info acara.</TextBlock>
          <Button x:Name="SaveInfoBtn" Content="Simpan Perubahan"
                  Style="{DynamicResource PrimaryButton}" Click="OnSaveInfo"/>
        </StackPanel>
      </GroupBox>
      <GroupBox Header="Meja (maks 10)" Margin="0,0,0,6">
        <StackPanel>
          <!-- Chips deletable cermin Flutter -->
          <WrapPanel x:Name="MejaChips" Orientation="Horizontal"/>
          <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
            <TextBox x:Name="MejaBox" Width="220"/>
            <Button Content="Tambah" Margin="8,0,0,0" Click="OnAddMeja" Style="{DynamicResource TonalButton}"/>
          </StackPanel>
        </StackPanel>
      </GroupBox>
      <GroupBox x:Name="MemberBox" Header="Anggota (OWNER)" Margin="0,0,0,6">
        <StackPanel>
          <!-- Baris tambah cermin web/Flutter: cari user + pilih role + tombol plus -->
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="130"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBox x:Name="SearchBox" Grid.Column="0" TextChanged="OnSearch"
                     VerticalContentAlignment="Center"/>
            <ComboBox x:Name="AddRoleBox" Grid.Column="1" Margin="8,0,0,0"
                      SelectedIndex="1" VerticalContentAlignment="Center"
                      ToolTip="Role untuk anggota baru">
              <ComboBoxItem Content="VIEWER"/>
              <ComboBoxItem Content="ADMIN"/>
              <ComboBoxItem Content="OWNER"/>
            </ComboBox>
            <Button Grid.Column="2" Content="+ Tambah" Margin="8,0,0,0"
                    Click="OnAddSelectedMember" Style="{DynamicResource PrimaryButton}"
                    ToolTip="Tambah user terpilih dengan role di samping"/>
          </Grid>
          <TextBlock FontSize="11" Foreground="{DynamicResource OnVariantBrush}"
                     Margin="0,2,0,0">Ketik min 2 huruf, pilih hasil lalu + Tambah (atau double-click).</TextBlock>
          <ListBox x:Name="ResultList" Height="100" Margin="0,4,0,0"
                   MouseDoubleClick="OnAddMember"/>
          <DataGrid x:Name="MemberGrid" AutoGenerateColumns="False" IsReadOnly="True"
                    Margin="0,8,0,0" HeadersVisibility="Column" MaxHeight="250">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Nama" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Email" Binding="{Binding Email}" Width="*"/>
              <DataGridTextColumn Header="Role" Binding="{Binding Role}" Width="100"/>
              <!-- Ubah role via dialog Edit (lebih jelas dari ComboBox inline) -->
              <DataGridTemplateColumn Header="Aksi" Width="170">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                      <Button Content="Edit" Click="OnEditMemberRole" Padding="10,2" Margin="0,0,6,0"
                              Style="{DynamicResource TonalButton}" ToolTip="Ubah role anggota"/>
                      <Button Content="Hapus" Click="OnRemoveMember" Padding="10,2"
                              ToolTip="Keluarkan anggota"/>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </GroupBox>
      <!-- Danger zone cermin Flutter (ketik HAPUS untuk konfirmasi) -->
      <Button x:Name="DeleteBtn" Content="Hapus Acara Permanen" Click="OnDelete"
              Style="{DynamicResource DangerButton}"/>
    </StackPanel>
  </ScrollViewer>
</Window>
