<Window x:Class="HajatManager.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pengaturan Acara" Height="260" Width="440"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource SurfaceBrush}">
  <!-- Task 7: fallback redirect — pengaturan kini tab Setting di detail acara. -->
  <StackPanel Margin="16" VerticalAlignment="Center">
    <Border Style="{DynamicResource M3Card}">
      <StackPanel>
        <TextBlock Text="Pengaturan pindah" FontWeight="SemiBold" FontSize="14"/>
        <TextBlock x:Name="RedirectText" Margin="0,4,0,0" TextWrapping="Wrap"
                   Foreground="{DynamicResource OnVariantBrush}" FontSize="12"
                   Text="Pengaturan acara kini ada di tab Setting pada halaman detail acara."/>
        <Button Content="Tutup" Click="OnClose" Margin="0,12,0,0"
                Style="{DynamicResource PrimaryButton}" HorizontalAlignment="Right"
                MinWidth="120"/>
      </StackPanel>
    </Border>
  </StackPanel>
</Window>
